# Copy to .env (or just export these in your shell) to override defaults.

# Directory where the SQLite database and any runtime artefacts live.
# Default: ./data
# GEOSPATIAL_DATA_DIR=./data

# SQLite database filename.
# Default: $GEOSPATIAL_DATA_DIR/geospatial.db
# GEOSPATIAL_DATABASE_PATH=./data/geospatial.db

# Maximum upload size, in bytes.  Default: 52428800 (50 MiB).
# GEOSPATIAL_MAX_UPLOAD_BYTES=52428800
